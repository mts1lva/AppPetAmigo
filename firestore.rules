// Regras de segurança do Cloud Firestore (`docs/specs/comum/dados-e-sync.md`; P5-1.5).
// Cada usuário autenticado só lê e grava os próprios documentos em
// `usuarios/{uid}/{colecao}/{docId}` (inclusive `fotos`).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{colecao}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
