// Regras da cópia remota (`docs/specs/comum/dados-e-sync.md`).
// O P5 publica a versão final (P5-1.5). Este arquivo existe desde a P2-2.3
// para o Firebase Emulator Suite subir nos testes de integração de todos.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{colecao}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
